# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/jobtrack_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password

# JWT Authentication Security
JWT_SECRET=your_super_secret_jwt_key_min_64_bytes_long_string_for_hs512_security
JWT_EXPIRATION=3600000

# CORS Allowed Origins (Comma-separated)
JOBTRACK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Document File Storage Directory
JOBTRACK_UPLOAD_DIR=uploads/job-applications

# Server Port
PORT=8080

# Spring Active Profile
SPRING_PROFILES_ACTIVE=prod
